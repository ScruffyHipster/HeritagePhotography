---
interface Props {
  email: string;
  instagram: string;
  facebook: string;
  footer: string;
  copy: {
    eyebrow: string;
    heading: string;
    instagramLabel: string;
    facebookLabel: string;
  };
}
const { email, instagram, facebook, footer, copy } = Astro.props;
---
<footer class="footer">
  <div class="footer__lead">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2>{copy.heading}</h2>
    <a class="text-link text-link--large" href={`mailto:${email}`}>{email}</a>
  </div>
  <div class="footer__base">
    <p>© {new Date().getFullYear()} {footer}</p>
    <a class="footer__credit" href="https://www.scruffyhipster.com" target="_blank" rel="noopener noreferrer">Website crafted by Scruffy Hipster LTD <span aria-hidden="true">↗</span></a>
    <div class="footer__links">
      <a href={instagram} target="_blank" rel="noopener noreferrer">{copy.instagramLabel} <span aria-hidden="true">↗</span></a>
      <a href={facebook} target="_blank" rel="noopener noreferrer">{copy.facebookLabel} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</footer>

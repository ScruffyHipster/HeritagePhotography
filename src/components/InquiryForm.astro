---
import { getEntry } from 'astro:content';

interface Props {
  kind?: 'contact' | 'product';
  product?: string;
  buttonLabel?: string;
  email: string;
}
const { kind = 'contact', product = '', email } = Astro.props;
const shared = await getEntry('shared', 'shared');
if (!shared) throw new Error('Shared wording is missing.');
const copy = shared.data.form;
const buttonLabel = Astro.props.buttonLabel ?? copy.contactSubmitLabel;
---
<form
  class="inquiry-form"
  data-inquiry-form
  data-kind={kind}
  data-email={email}
  data-product={product}
  data-email-ready-status={copy.emailReadyStatus}
  data-copy-success-status={copy.copySuccessStatus}
  data-copy-failure-status={copy.copyFailureStatus}
  data-email-copy={JSON.stringify(copy.email)}
>
  <div class="field-row">
    <label>
      <span>{copy.nameLabel}</span>
      <input name="name" type="text" autocomplete="name" required />
    </label>
    <label>
      <span>{copy.emailLabel}</span>
      <input name="replyTo" type="email" autocomplete="email" required />
    </label>
  </div>
  {kind === 'product' ? (
    <>
      <label>
        <span>{copy.itemLabel}</span>
        <input name="item" type="text" value={product} required />
      </label>
      <div class="field-row field-row--three">
        <label>
          <span>{copy.presentationLabel}</span>
          <select name="presentation">{copy.presentationOptions.map((option) => <option>{option}</option>)}</select>
        </label>
        <label>
          <span>{copy.frameLabel}</span>
          <select name="frame">{copy.frameOptions.map((option) => <option>{option}</option>)}</select>
        </label>
        <label>
          <span>{copy.quantityLabel}</span>
          <input name="quantity" type="number" value="1" min="1" max="20" required />
        </label>
      </div>
    </>
  ) : (
    <label>
      <span>{copy.topicLabel}</span>
      <select name="topic">
        {copy.topicOptions.map((option) => <option>{option}</option>)}
      </select>
    </label>
  )}
  <label>
    <span>{kind === 'product' ? copy.productMessageLabel : copy.contactMessageLabel}</span>
    <textarea name="message" rows="6" required></textarea>
  </label>
  <div class="form-actions">
    <button class="button" type="submit">{buttonLabel}</button>
    <button class="button button--quiet" type="button" data-copy>{copy.copyButtonLabel}</button>
  </div>
  <p class="form-status" role="status" aria-live="polite" data-status>
    {copy.helpText} <a href={`mailto:${email}`}>{email}</a>.
  </p>
</form>

<script>
  import { buildEnquiry, createMailto } from '../lib/enquiry.mjs';

  document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const getEmail = () => {
      const data = new FormData(form);
      return buildEnquiry(Object.fromEntries(data.entries()), {
        kind: form.dataset.kind,
        product: form.dataset.product,
        copy: JSON.parse(form.dataset.emailCopy ?? '{}'),
      });
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const enquiry = getEmail();
      window.location.href = createMailto(form.dataset.email, enquiry);
      if (status) status.textContent = form.dataset.emailReadyStatus ?? '';
    });

    form.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async () => {
      if (!form.reportValidity()) return;
      const { subject, body } = getEmail();
      try {
        await navigator.clipboard.writeText(`${subject}\n\n${body}`);
        if (status) status.textContent = form.dataset.copySuccessStatus ?? '';
      } catch {
        if (status) status.textContent = form.dataset.copyFailureStatus ?? '';
      }
    });
  });
</script>

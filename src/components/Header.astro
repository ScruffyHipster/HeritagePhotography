---
import { withBase } from '../lib/paths';

interface Props {
  name: string;
  monogram: string;
  navigation: Array<{ label: string; href: string }>;
}
const { name, monogram, navigation } = Astro.props;
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  const resolvedHref = withBase(href);
  return href === '/' ? currentPath === resolvedHref || currentPath === `${resolvedHref}/` : currentPath.startsWith(resolvedHref);
};
---
<header class="site-header" data-header>
  <a class="brand" href={withBase('/')} aria-label={`${name} home`}>
    <span class="monogram" aria-hidden="true">{monogram}</span>
    <span class="brand__name">Heritage Buildings<br />Photographer</span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
    <span>Menu</span>
    <i aria-hidden="true"></i>
  </button>
  <nav id="site-nav" class="site-nav" aria-label="Primary navigation" data-nav>
    <div class="site-nav__label">Navigate</div>
    <ul>
      {navigation.map((item) => (
        <li><a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    document.body.classList.toggle('menu-open', !open);
  });

  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  const compactHeader = () => header?.classList.toggle('is-compact', window.scrollY > 72);
  compactHeader();
  window.addEventListener('scroll', compactHeader, { passive: true });
</script>

---
import { withBase } from '../lib/paths';

interface Props {
  logo: string;
  navigation: Array<{ label: string; href: string }>;
  copy: {
    homeLabel: string;
    brandLineOne: string;
    brandLineTwo: string;
    menuLabel: string;
    navigationLabel: string;
    primaryNavigationLabel: string;
  };
}
const { logo, navigation, copy } = Astro.props;
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  const resolvedHref = withBase(href);
  return href === '/' ? currentPath === resolvedHref || currentPath === `${resolvedHref}/` : currentPath.startsWith(resolvedHref);
};
---
<header class="site-header" data-header>
  <a class="brand" href={withBase('/')} aria-label={copy.homeLabel}>
    <img class="brand__logo" src={withBase(logo)} alt="" width="1000" height="1000" aria-hidden="true" />
    <span class="brand__name">{copy.brandLineOne}<br />{copy.brandLineTwo}</span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
    <span>{copy.menuLabel}</span>
    <i aria-hidden="true"></i>
  </button>
  <nav id="site-nav" class="site-nav" aria-label={copy.primaryNavigationLabel} data-nav>
    <div class="site-nav__label">{copy.navigationLabel}</div>
    <ul>
      {navigation.map((item) => (
        <li><a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  let menuScrollPosition = 0;

  const closeMenu = () => {
    if (!document.body.classList.contains('menu-open')) return;

    toggle?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
    document.body.style.removeProperty('--menu-scroll-position');
    window.scrollTo(0, menuScrollPosition);
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';

    if (open) {
      closeMenu();
      return;
    }

    menuScrollPosition = window.scrollY;
    document.body.style.setProperty('--menu-scroll-position', `-${menuScrollPosition}px`);
    toggle.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
  });

  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  const compactHeader = () => header?.classList.toggle('is-compact', window.scrollY > 72);
  compactHeader();
  window.addEventListener('scroll', compactHeader, { passive: true });
</script>

---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageFrame from '../components/ImageFrame.astro';
const about = await getEntry('pages', 'about');
if (!about) throw new Error('About content is missing.');
const { Content } = await render(about);
---
<BaseLayout title={about.data.seo?.title} description={about.data.seo?.description}>
  <section class="page-hero page-hero--split">
    <div>
      <p class="eyebrow">{about.data.eyebrow}</p>
      <h1>{about.data.heroTitle}</h1>
      <p class="lede">{about.data.introduction}</p>
    </div>
    {about.data.hero && <ImageFrame {...about.data.hero} priority />}
  </section>
  <section class="prose-layout">
    <aside><p class="section-number">My work</p></aside>
    <article class="prose"><Content /></article>
  </section>
</BaseLayout>

---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
const site = await getEntry('site', 'site');
const contact = await getEntry('pages', 'contact');
if (!site || !contact || contact.data.title !== 'Contact') throw new Error('Site settings or contact content are missing.');
const initialTopic = Astro.url.searchParams.get('subject')?.trim() ?? '';
---
<BaseLayout title={contact.data.seo?.title} description={contact.data.seo?.description} socialImage={contact.data.seo?.socialImage}>
  <section class="contact-hero">
    <div>
      <p class="eyebrow">{contact.data.eyebrow}</p>
      <h1>{contact.data.heroTitle}</h1>
      <p class="lede">{contact.data.introduction}</p>
      <div class="contact-direct">
        <span>{contact.data.directEmailLabel}</span>
        <a href={`mailto:${site.data.email}`}>{site.data.email}</a>
      </div>
    </div>
    <InquiryForm email={site.data.email} buttonLabel={contact.data.formSubmitLabel} initialTopic={initialTopic} />
  </section>
</BaseLayout>

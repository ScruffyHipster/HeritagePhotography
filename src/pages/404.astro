---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found">
  <section class="page-hero page-hero--error">
    <p class="eyebrow">404</p>
    <h1>This path has faded from view.</h1>
    <p class="lede">The page may have moved, but the archive is still close at hand.</p>
    <div class="actions"><a class="button" href="/">Return home</a><a class="text-link" href="/gallery/">Browse the gallery</a></div>
  </section>
</BaseLayout>

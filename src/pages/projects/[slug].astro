---
import { getCollection, getEntry, render } from 'astro:content';
import { relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import sharp from 'sharp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryPhotoGrid from '../../components/GalleryPhotoGrid.astro';
import ImageFrame from '../../components/ImageFrame.astro';
import { withBase } from '../../lib/paths';

const publicDirectory = fileURLToPath(new URL('../../../public/', import.meta.url));

async function getImageDimensions(image: string) {
  const imagePath = resolve(publicDirectory, image.replace(/^\//, ''));
  const imageRelativePath = relative(publicDirectory, imagePath);

  if (imageRelativePath.startsWith('..') || imageRelativePath === '') {
    throw new Error(`Project image must be inside public/: ${image}`);
  }

  const { width, height } = await sharp(imagePath).metadata();
  if (!width || !height) throw new Error(`Could not read dimensions for project image: ${image}`);

  return { width, height };
}

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, projects } }));
}
const { project, projects } = Astro.props;
const ordered = [...projects].sort((a, b) => a.data.order - b.data.order);
const index = ordered.findIndex((item) => item.id === project.id);
const previous = ordered[(index - 1 + ordered.length) % ordered.length];
const next = ordered[(index + 1) % ordered.length];
const { Content } = await render(project);
const [page, shared] = await Promise.all([
  getEntry('pages', 'projects'),
  getEntry('shared', 'shared'),
]);
if (!page || page.data.title !== 'Projects') throw new Error('Projects page content is missing.');
if (!shared) throw new Error('Shared wording is missing.');
const photos = await Promise.all(project.data.gallery.map(async (photo) => ({
  ...photo,
  ...(photo.image ? await getImageDimensions(photo.image) : {}),
})));
---
<BaseLayout title={project.data.seo?.title ?? project.data.title} description={project.data.seo?.description ?? project.data.summary} socialImage={project.data.seo?.socialImage}>
  <article>
    <header class="detail-hero">
      <div class="detail-hero__copy">
        <p class="eyebrow">{page.data.detailPrefix} {String(index + 1).padStart(2, '0')}</p>
        <h1>{project.data.title}</h1>
        <p class="lede">{project.data.summary}</p>
      </div>
      <ImageFrame {...project.data.hero} priority parallax />
    </header>
    <div class="prose-layout">
      <aside><p class="section-number">{page.data.storyLabel}</p></aside>
      <div class="prose"><Content /></div>
    </div>
    <GalleryPhotoGrid
      id={`project-${project.id}`}
      label={`${project.data.title} ${page.data.photographsLabel}`}
      photos={photos}
      emptyLabel={shared.data.imagePlaceholder.status}
    />
  </article>
  <nav class="previous-next" aria-label={page.data.navigationLabel}>
    <a href={withBase(`/projects/${previous.id}/`)}><span>{page.data.previousLabel}</span>{previous.data.title}</a>
    <a href={withBase('/projects/')}><span>{page.data.indexLabel}</span>{page.data.allProjectsLabel}</a>
    <a href={withBase(`/projects/${next.id}/`)}><span>{page.data.nextLabel}</span>{next.data.title}</a>
  </nav>
</BaseLayout>

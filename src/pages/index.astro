---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageFrame from '../components/ImageFrame.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase } from '../lib/paths';
import { formatEventDate } from '../lib/dates';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Homepage content is missing.');
if (home.data.title !== 'Home') throw new Error('Homepage content has the wrong page type.');
const homeData = home.data;
const projectsPage = await getEntry('pages', 'projects');
if (!projectsPage || projectsPage.data.title !== 'Projects') throw new Error('Projects page content is missing.');
const projectsPageData = projectsPage.data;
const projects = (await getCollection('projects'))
  .filter((project) => homeData.featuredProjects.includes(project.id))
  .sort((a, b) => homeData.featuredProjects.indexOf(a.id) - homeData.featuredProjects.indexOf(b.id));
const galleries = await getCollection('galleries');
const featuredGallery = galleries.find((gallery) => gallery.id === homeData.featuredGallery);
const events = await getCollection('events');
const featuredEvent = events.find((event) => event.id === homeData.featuredEvent);
---
<BaseLayout title={home.data.seo?.title} description={home.data.seo?.description} socialImage={home.data.seo?.socialImage}>
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="eyebrow">{home.data.eyebrow}</p>
      <h1>{home.data.heroTitle}</h1>
      <p class="lede">{home.data.introduction}</p>
      <div class="actions">
        {home.data.primaryCta && <a class="button" href={withBase(home.data.primaryCta.href)}>{home.data.primaryCta.label}</a>}
        {home.data.secondaryCta && <a class="text-link" href={withBase(home.data.secondaryCta.href)}>{home.data.secondaryCta.label}</a>}
      </div>
    </div>
    {home.data.hero && <ImageFrame {...home.data.hero} priority parallax class="home-hero__image" />}
    <p class="scroll-cue" aria-hidden="true">{home.data.scrollCue} <i></i></p>
  </section>

  <section class="intro-section section-grid reveal">
    <p class="section-number">{home.data.introductionLabel}</p>
    <div class="intro-section__copy">
      <h2>{home.data.introductionHeading}</h2>
      <p>{home.data.introductionText}</p>
      <a class="text-link" href={withBase(home.data.introductionLink.href)}>{home.data.introductionLink.label}</a>
    </div>
    <ImageFrame {...home.data.introductionImage} />
  </section>

  <section class="lens-passage">
    <div class="lens-passage__title reveal">
      <span>{home.data.lensKicker}</span>
      <h2>{home.data.lensHeading}</h2>
    </div>
    <ImageFrame {...home.data.lensImage} parallax />
    <p class="lens-passage__note reveal">{home.data.lensNote}</p>
  </section>

  <section class="listing-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{home.data.projectsEyebrow}</p>
        <h2>{home.data.projectsHeading}</h2>
      </div>
      <a class="text-link" href={withBase(home.data.projectsLink.href)}>{home.data.projectsLink.label}</a>
    </div>
    <div class="project-list">
      {projects.map((project, index) => <ProjectCard project={project} index={index} copy={projectsPageData} />)}
    </div>
  </section>

  {featuredEvent && (
    <section class="event-feature section-grid reveal">
      <p class="section-number">{home.data.eventLabel}</p>
      <ImageFrame {...featuredEvent.data.image} />
      <div class="event-feature__copy">
        <p class="eyebrow">{home.data.eventEyebrow}</p>
        <h2>{featuredEvent.data.title}</h2>
        <p>{featuredEvent.data.description}</p>
        <dl>
          <div><dt>{home.data.eventWhenLabel}</dt><dd>{formatEventDate(featuredEvent.data)}</dd></div>
          <div><dt>{home.data.eventWhereLabel}</dt><dd>{featuredEvent.data.venue}</dd></div>
        </dl>
        <a class="text-link" href={withBase(home.data.eventLink.href)}>{home.data.eventLink.label}</a>
      </div>
    </section>
  )}

  {featuredGallery && (
    <section class="gallery-invite reveal">
      <ImageFrame {...featuredGallery.data.cover} shape="panorama" parallax />
      <div class="gallery-invite__copy">
        <p class="eyebrow">{home.data.galleryEyebrow}</p>
        <h2>{home.data.galleryHeading}</h2>
        <p>{featuredGallery.data.introduction}</p>
        <a class="button button--light" href={withBase(home.data.galleryLink.href)}>{home.data.galleryLink.label}</a>
      </div>
    </section>
  )}
</BaseLayout>

---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageFrame from '../components/ImageFrame.astro';
import InquiryForm from '../components/InquiryForm.astro';
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const site = await getEntry('site', 'site');
const page = await getEntry('pages', 'shop');
if (!site || !page || page.data.title !== 'Shop') throw new Error('Site settings or shop content are missing.');
const pageData = page.data;
---
<BaseLayout title={page.data.seo?.title} description={page.data.seo?.description} socialImage={page.data.seo?.socialImage}>
  <section class="page-hero">
    <p class="eyebrow">{page.data.eyebrow}</p>
    <h1>{page.data.heroTitle}</h1>
    <p class="lede">{page.data.introduction}</p>
  </section>
  <section class="products listing-section">
    {products.map((product, index) => (
      <article class="product reveal">
        <div class="product__visuals">
          {product.data.previews.map((preview) => <ImageFrame {...preview} />)}
        </div>
        <div class="product__copy">
          <p class="eyebrow">{pageData.itemPrefix} {String(index + 1).padStart(2, '0')}</p>
          <h2>{product.data.title}</h2>
          <p>{product.data.description}</p>
          <p class="price">{product.data.price}</p>
          <ul>{product.data.options.map((option) => <li>{option}</li>)}</ul>
          <p class="small">{product.data.postageNote}</p>
          <details>
            <summary class="button">{product.data.enquiryLabel}</summary>
            <InquiryForm kind="product" product={product.data.title} email={site.data.email} buttonLabel={pageData.orderEmailLabel} />
          </details>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

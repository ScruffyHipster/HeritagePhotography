---
import { getCollection, getEntry } from 'astro:content';
import { relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import sharp from 'sharp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryPhotoGrid from '../../components/GalleryPhotoGrid.astro';
import ImageFrame from '../../components/ImageFrame.astro';
import { withBase } from '../../lib/paths';

const publicDirectory = fileURLToPath(new URL('../../../public/', import.meta.url));

async function getImageDimensions(image: string) {
  const imagePath = resolve(publicDirectory, image.replace(/^\//, ''));
  const imageRelativePath = relative(publicDirectory, imagePath);

  if (imageRelativePath.startsWith('..') || imageRelativePath === '') {
    throw new Error(`Gallery image must be inside public/: ${image}`);
  }

  const { width, height } = await sharp(imagePath).metadata();
  if (!width || !height) throw new Error(`Could not read dimensions for gallery image: ${image}`);

  return { width, height };
}
export async function getStaticPaths() {
  const galleries = await getCollection('galleries');
  return galleries.map((gallery) => ({ params: { slug: gallery.id }, props: { gallery, galleries } }));
}
const { gallery, galleries } = Astro.props;
const ordered = [...galleries].sort((a, b) => a.data.order - b.data.order);
const index = ordered.findIndex((item) => item.id === gallery.id);
const previous = ordered[(index - 1 + ordered.length) % ordered.length];
const next = ordered[(index + 1) % ordered.length];
const [page, shared] = await Promise.all([
  getEntry('pages', 'gallery'),
  getEntry('shared', 'shared'),
]);
if (!page || page.data.title !== 'Gallery') throw new Error('Gallery page content is missing.');
if (!shared) throw new Error('Shared wording is missing.');
const photos = await Promise.all(gallery.data.photos.map(async (photo) => ({
  ...photo,
  ...(photo.image ? await getImageDimensions(photo.image) : {}),
})));
---
<BaseLayout title={gallery.data.seo?.title ?? gallery.data.title} description={gallery.data.seo?.description ?? gallery.data.introduction} socialImage={gallery.data.seo?.socialImage}>
  <header class="detail-hero detail-hero--gallery">
    <div class="detail-hero__copy">
      <p class="eyebrow">{page.data.detailPrefix} {String(index + 1).padStart(2, '0')}</p>
      <h1>{gallery.data.title}</h1>
      <p class="lede">{gallery.data.introduction}</p>
    </div>
    <ImageFrame {...gallery.data.cover} priority />
  </header>
  <GalleryPhotoGrid
    id={`gallery-${gallery.id}`}
    label={`${gallery.data.title} ${page.data.photographsLabel}`}
    photos={photos}
    emptyLabel={shared.data.imagePlaceholder.status}
  />
  <nav class="previous-next" aria-label={page.data.navigationLabel}>
    <a href={withBase(`/gallery/${previous.id}/`)}><span>{page.data.previousLabel}</span>{previous.data.title}</a>
    <a href={withBase('/gallery/')}><span>{page.data.indexLabel}</span>{page.data.allGalleriesLabel}</a>
    <a href={withBase(`/gallery/${next.id}/`)}><span>{page.data.nextLabel}</span>{next.data.title}</a>
  </nav>
</BaseLayout>

---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageFrame from '../../components/ImageFrame.astro';
import { withBase } from '../../lib/paths';
const galleries = (await getCollection('galleries')).sort((a, b) => a.data.order - b.data.order);
const page = await getEntry('pages', 'gallery');
if (!page || page.data.title !== 'Gallery') throw new Error('Gallery page content is missing.');
---
<BaseLayout title={page.data.seo?.title} description={page.data.seo?.description} socialImage={page.data.seo?.socialImage}>
  <section class="page-hero">
    <p class="eyebrow">{page.data.eyebrow}</p>
    <h1>{page.data.heroTitle}</h1>
    <p class="lede">{page.data.introduction}</p>
  </section>
  <section class="gallery-grid listing-section">
    {galleries.map((gallery, index) => (
      <article class:list={['gallery-card', index % 3 === 1 && 'gallery-card--raised', 'reveal']}>
        <a href={withBase(`/gallery/${gallery.id}/`)}>
          <ImageFrame {...gallery.data.cover} />
          <span class="index">{String(index + 1).padStart(2, '0')}</span>
          <h2>{gallery.data.title}</h2>
          <p>{gallery.data.introduction}</p>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

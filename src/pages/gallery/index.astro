---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageFrame from '../../components/ImageFrame.astro';
import { withBase } from '../../lib/paths';
const galleries = (await getCollection('galleries')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Heritage photography gallery" description="Browse photographs from Doncaster, exhibitions, Heritage Open Days, tours and day trips.">
  <section class="page-hero">
    <p class="eyebrow">Gallery index</p>
    <h1>Doncaster, exhibitions and travels.</h1>
    <p class="lede">Browse photographs from the Doncaster Detail Quizzes, Heritage Open Days, city streets, tours and day trips.</p>
  </section>
  <section class="gallery-grid listing-section">
    {galleries.map((gallery, index) => (
      <article class:list={['gallery-card', index % 3 === 1 && 'gallery-card--raised', 'reveal']}>
        <a href={withBase(`/gallery/${gallery.id}/`)}>
          <ImageFrame {...gallery.data.cover} />
          <span class="index">{String(index + 1).padStart(2, '0')}</span>
          <h2>{gallery.data.title}</h2>
          <p>{gallery.data.introduction}</p>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
